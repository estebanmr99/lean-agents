{
  "servers": {
    "serena": {
      "description": "Symbol-level code navigation so agents read less code.",
      "upstream": "https://github.com/oraios/serena",
      "command": ["uvx", "-p", "3.13", "--from", "{pin:serena}", "serena", "start-mcp-server", "--project-from-cwd"],
      "context": { "claude-code": "claude-code", "default": "ide" },
      "optional": true
    },
    "playwright": {
      "description": "Browser automation for checking web UIs.",
      "upstream": "https://github.com/microsoft/playwright-mcp",
      "command": ["npx", "-y", "{pin:playwright-mcp}"],
      "optional": true
    },
    "playwright-extension": {
      "description": "Playwright MCP attached to the user's own signed-in Chrome or Edge through the Playwright Extension.",
      "upstream": "https://github.com/microsoft/playwright-mcp",
      "command": ["npx", "-y", "{pin:playwright-mcp}", "--extension"],
      "optional": true
    },
    "context-mode": {
      "description": "Keeps large tool outputs out of the context window. Used as MCP only where its plugin is unavailable.",
      "upstream": "https://github.com/mksglu/context-mode",
      "command": ["npx", "-y", "{pin:context-mode}", "server"],
      "node_command": ["{node}", "{modules}/context-mode/cli.mjs", "server"],
      "legacy": [
        ["npx", "-y", "context-mode@*"],
        ["npx", "-y", "context-mode@*", "server"],
        ["*/versions/node/v*/bin/node", "*/versions/node/v*/lib/node_modules/context-mode/cli.mjs", "server"],
        ["*\\v*\\node.exe", "*\\v*\\node_modules\\context-mode\\cli.mjs", "server"]
      ],
      "optional": false,
      "mcp_only_for": ["opencode-v2", "copilot-cli", "antigravity"]
    }
  }
}
